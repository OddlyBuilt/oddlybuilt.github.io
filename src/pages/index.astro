---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site, projects, services, principles } from '../content';
---

<BaseLayout>
  <!-- ======================================================== HEADER -->
  <header class="bar">
    <div class="wrap bar-inner">
      <a href="/" class="logo" aria-label={`${site.name} home`}>
        <img class="logo-mark" src="/favicon.png" width="34" height="34" alt="" />
        <span class="logo-name">{site.name}</span>
      </a>
      <nav class="nav">
        <a href="#work">Work</a>
        <a href="#services">What I do</a>
        <a href="#contact">Contact</a>
      </nav>
      <a href="#contact" class="btn btn-primary bar-cta">Start a project</a>
    </div>
  </header>

  <!-- ========================================================== HERO -->
  <section class="hero">
    <div class="wrap">
      <p class="kicker reveal">Solo developer · {site.location}</p>
      <h1 class="hero-title reveal">
        Websites and tools,<br /><span class="hl">built properly.</span>
      </h1>
      <p class="hero-lead reveal">
        I build fast, low-maintenance sites and small products — the kind you can edit yourself,
        that don't fall over, and that still work in five years.
      </p>
      <div class="hero-cta reveal">
        <a href="#contact" class="btn btn-primary">Start a project <span class="arrow">→</span></a>
        <a href="#work" class="btn btn-ghost">See the work</a>
      </div>

      <dl class="facts reveal">
        <div><dt>Based in</dt><dd>{site.location}</dd></div>
        <div><dt>Working with</dt><dd>Clients anywhere</dd></div>
        <div><dt>Usual first step</dt><dd>A short call, no charge</dd></div>
      </dl>
    </div>
  </section>

  <!-- ========================================================== WORK -->
  <section class="section work" id="work">
    <div class="wrap">
      <p class="kicker reveal">Selected work</p>
      <h2 class="section-title reveal">Things I've shipped.</h2>

      <div class="projects">
        {projects.map((p) => (
          <article class="project reveal">
            <div class="p-head">
              <h3>{p.name}</h3>
              {p.href ? (
                <a class="p-link" href={p.href} target="_blank" rel="noopener noreferrer">
                  Visit <span class="arrow">↗</span>
                </a>
              ) : (
                <span class="p-status">{p.status}</span>
              )}
            </div>
            <p class="p-blurb">{p.blurb}</p>
            <p class="p-detail">{p.detail}</p>
            <ul class="stack">
              {p.stack.map((s) => <li>{s}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ====================================================== SERVICES -->
  <section class="section services" id="services">
    <div class="wrap">
      <p class="kicker reveal">What I do</p>
      <h2 class="section-title reveal">Three kinds of job.</h2>
      <div class="svc-grid">
        {services.map((s) => (
          <article class="svc reveal">
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ==================================================== PRINCIPLES -->
  <section class="section how">
    <div class="wrap">
      <p class="kicker reveal">How I work</p>
      <h2 class="section-title reveal">No surprises.</h2>
      <div class="principles">
        {principles.map((p) => (
          <article class="principle reveal">
            <span class="p-n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ======================================================= CONTACT -->
  <section class="section contact" id="contact">
    <div class="wrap contact-grid">
      <div>
        <p class="kicker reveal">Contact</p>
        <h2 class="section-title reveal">Tell me what you're building.</h2>
        <p class="contact-lead reveal">
          A couple of lines is plenty. If it's a fit I'll say so, and if it isn't I'll tell you that
          too — usually with a pointer to someone better suited.
        </p>

        <div class="alt reveal">
          <p class="alt-note">
            Prefer email? <a class="ul" href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
      </div>

      {/*
        Pages serves static files only — there is no handler to POST to, so submit
        composes a prefilled email instead. No backend, and no bots to honeypot.
        `action` is the no-JS fallback: it still opens a mail client, just without
        the fields filled in.
      */}
      <form class="form reveal" id="enquiry" name="enquiry" action={`mailto:${site.email}`}>
        <div class="field">
          <label for="name">Your name</label>
          <input id="name" name="name" type="text" required autocomplete="name" />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" required autocomplete="email" />
        </div>
        <div class="field">
          <label for="budget">Rough budget <span class="opt">optional</span></label>
          <select id="budget" name="budget">
            <option value="">Not sure yet</option>
            <option>Under ₹50k</option>
            <option>₹50k – ₹2L</option>
            <option>₹2L+</option>
          </select>
        </div>
        <div class="field">
          <label for="message">What are you building?</label>
          <textarea id="message" name="message" rows="5" required></textarea>
        </div>

        <button type="submit" class="btn btn-primary submit">Send it <span class="arrow">→</span></button>
        <p class="form-note">Opens your mail app, prefilled. I reply within a day, usually sooner.</p>
      </form>

      <script is:inline define:vars={{ to: site.email }}>
        // Progressive enhancement: without this the form still submits to its
        // mailto action, just empty. With it, the fields become the subject and
        // body of a draft.
        document.getElementById('enquiry')?.addEventListener('submit', (e) => {
          e.preventDefault();
          const f = e.target;
          const v = (n) => f.elements[n].value.trim();
          const body = [
            `Name: ${v('name')}`,
            `Email: ${v('email')}`,
            `Budget: ${v('budget') || 'Not sure yet'}`,
            '',
            v('message'),
          ].join('\n');
          window.location.href =
            `mailto:${to}?subject=${encodeURIComponent(`Enquiry from ${v('name')}`)}` +
            `&body=${encodeURIComponent(body)}`;
        });
      </script>
    </div>
  </section>

  <!-- ======================================================== FOOTER -->
  <footer class="foot">
    <div class="wrap foot-inner">
      <p>© {new Date().getFullYear()} {site.name}</p>
      <p class="foot-links">
        <a class="ul" href={site.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="ul" href={`mailto:${site.email}`}>Email</a>
      </p>
    </div>
  </footer>
</BaseLayout>

<style>
  /* ------------------------------------------------------------- header */
  .bar {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgba(244, 243, 239, 0.82);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  .bar-inner {
    display: flex;
    align-items: center;
    gap: 24px;
    padding-block: 14px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-right: auto;
  }
  /* The mark is the org logo: an OB monogram already set on its own black
     ground, so it needs no background of its own — just the same rounded
     corners the old text mark had. */
  .logo-mark {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    display: block;
  }
  .logo-name { font-weight: 650; letter-spacing: -0.02em; }
  .nav { display: flex; gap: 26px; font-size: 0.95rem; color: var(--muted); }
  .nav a:hover { color: var(--ink); }
  .bar-cta { padding: 10px 16px; }

  /* --------------------------------------------------------------- hero */
  .hero { padding-block: clamp(64px, 12vw, 150px) clamp(48px, 7vw, 90px); }
  .hero-title {
    font-size: clamp(2.6rem, 8vw, 5.2rem);
    margin-top: 20px;
    max-width: 20ch;
  }
  .hl {
    /* Marker-pen band: stops short of the bottom of the line box so it reads as
       a deliberate stroke rather than a misaligned block behind the text. */
    background: linear-gradient(
      transparent 54%,
      var(--accent-soft) 54%,
      var(--accent-soft) 88%,
      transparent 88%
    );
  }
  .hero-lead {
    margin-top: 26px;
    font-size: clamp(1.05rem, 2vw, 1.3rem);
    color: var(--muted);
    max-width: 56ch;
  }
  .hero-cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 20px;
    margin-top: 64px;
    padding-top: 28px;
    border-top: 1px solid var(--line);
  }
  .facts dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .facts dd { margin-top: 5px; font-weight: 550; }

  .section-title { font-size: clamp(1.9rem, 4.4vw, 3rem); margin-top: 14px; }

  /* --------------------------------------------------------------- work */
  .work { border-top: 1px solid var(--line); }
  .projects { margin-top: 44px; display: grid; gap: 18px; }
  .project {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    padding: clamp(22px, 3vw, 32px);
    transition: border-color 0.25s, transform 0.4s var(--ease);
  }
  .project:hover { border-color: var(--ink); transform: translateY(-2px); }
  .p-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .p-head h3 { font-size: 1.35rem; }
  .p-link { font-size: 0.9rem; font-weight: 600; color: var(--accent); white-space: nowrap; }
  .p-link:hover { text-decoration: underline; }
  .p-status {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    border: 1px solid var(--line);
    border-radius: 100px;
    padding: 3px 10px;
    white-space: nowrap;
  }
  .p-blurb { margin-top: 8px; font-weight: 550; }
  .p-detail { margin-top: 10px; color: var(--muted); max-width: 68ch; }
  .stack { list-style: none; padding: 0; margin-top: 18px; display: flex; flex-wrap: wrap; gap: 7px; }
  .stack li {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--muted);
    background: var(--paper-dim);
    border-radius: 5px;
    padding: 4px 9px;
  }

  /* ----------------------------------------------------------- services */
  .services { background: var(--paper-dim); border-block: 1px solid var(--line); }
  .svc-grid {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 26px;
  }
  .svc h3 { font-size: 1.15rem; }
  .svc p { margin-top: 10px; color: var(--muted); }

  /* --------------------------------------------------------- principles */
  .principles {
    margin-top: 44px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 30px;
  }
  .p-n {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--accent);
    font-weight: 500;
  }
  .principle h3 { font-size: 1.12rem; margin-top: 10px; }
  .principle p { margin-top: 9px; color: var(--muted); }

  /* ------------------------------------------------------------ contact */
  .contact { background: var(--ink); color: var(--paper); }
  .contact .kicker, .contact .contact-lead, .contact .alt-note { color: #9d9c96; }
  .contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 6vw, 72px);
    align-items: start;
  }
  .contact-lead { margin-top: 20px; max-width: 46ch; }
  .alt { margin-top: 32px; }
  .contact .btn-ghost { border-color: #3a3a3e; color: var(--paper); }
  .contact .btn-ghost:hover { border-color: var(--paper); }
  .alt-note { margin-top: 14px; font-size: 0.92rem; }
  .ul { text-decoration: underline; text-underline-offset: 3px; }
  .ul:hover { color: #fff; }

  .form {
    background: #17171a;
    border: 1px solid #2a2a2e;
    border-radius: var(--radius);
    padding: clamp(22px, 3vw, 32px);
  }
  /* Honeypot: hidden from people, visible to bots that fill everything in. */
  .field { margin-bottom: 16px; }
  .field label {
    display: block;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 6px;
  }
  .opt { color: #7c7b76; font-weight: 400; }
  .field input, .field select, .field textarea {
    width: 100%;
    padding: 11px 13px;
    border-radius: 8px;
    border: 1px solid #33333a;
    background: #0e0e10;
    color: var(--paper);
    font: inherit;
    font-size: 0.95rem;
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .field textarea { resize: vertical; }
  .field input:focus, .field select:focus, .field textarea:focus {
    outline: none;
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(59, 73, 223, 0.25);
  }
  .submit { width: 100%; justify-content: center; background: var(--paper); color: var(--ink); }
  .submit:hover { background: var(--accent); color: #fff; }
  .form-note { margin-top: 12px; font-size: 0.85rem; color: #7c7b76; text-align: center; }

  /* ------------------------------------------------------------- footer */
  .foot { background: var(--ink); color: #7c7b76; border-top: 1px solid #26262a; }
  .foot-inner {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 12px;
    padding-block: 26px;
    font-size: 0.88rem;
  }
  .foot-links { display: flex; gap: 20px; }

  /* --------------------------------------------------------- responsive */
  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 700px) {
    .nav { display: none; }
  }
  @media (max-width: 460px) {
    .bar-cta { display: none; }
  }
</style>
